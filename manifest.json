{
  "id": "nano-banana-photoshop-plugin",
  "name": "Astria Nano-Banana",
  "version": "2.0.56",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "allowCodeGenerationFromStrings": true,
    "launchProcess": {
      "schemes": [
        "https",
        "http"
      ],
      "extensions": [
        ".jpg",
        ".png"
      ]
    },
    "localFileSystem": "fullAccess",
    "webview": {
      "allow": "yes",
      "domains": [
        "https://openrouter.ai",
        "https://*.openrouter.ai",
        "https://www.astria.ai",
        "https://chat.astria.ai",
        "http://localhost:3000"
      ],
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localAndRemote"
    },
    "network": {
      "domains": [
        "https://openrouter.ai",
        "https://*.openrouter.ai",
        "https://api.astria.ai",
        "https://www.astria.ai",
        "https://mp.astria.ai",
        "https://ms.astria.ai",
        "https://md.astria.ai",
        "https://generativelanguage.googleapis.com",
        "http://localhost:3000"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "submitPrompt",
      "label": {
        "default": "Submit prompt"
      }
    },
    {
      "type": "panel",
      "id": "vanilla",
      "minimumSize": {
        "width": 230,
        "height": 230
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 550
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 600
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "dark",
            "darkest"
          ],
          "species": [
            "generic"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "generic"
          ]
        }
      ],
      "label": {
        "default": "Astria Nano-Banana"
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/dark.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium"
      ]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/light.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "lightest",
        "light"
      ]
    }
  ]
}
