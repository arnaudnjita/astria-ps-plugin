{
  "manifestVersion": 5,
  "id": "com.astria.generativefill",
  "name": "Nano-Banana",
  "version": "2.0.21",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "generativeFillPanel",
      "name": "Nano-Banana",
      "label": {
        "default": "Nano-Banana"
      },
      "minimumSize": {
        "width": 260,
        "height": 380
      },
      "preferredSize": {
        "width": 340,
        "height": 580
      },
      "maximumSize": {
        "width": 800,
        "height": 1400
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-23.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "https://openrouter.ai",
        "https://*.openrouter.ai"
      ]
    }
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon-23.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest"]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-48.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest"]
    }
  ]
}
