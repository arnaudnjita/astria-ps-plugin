{
  "manifestVersion": 5,
  "id": "com.astria.generativefill",
  "name": "Astria AI Generative Fill",
  "version": "1.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "generativeFillPanel",
      "name": "AI Generative Fill",
      "minimumSize": {
        "width": 300,
        "height": 450
      },
      "preferredSize": {
        "width": 360,
        "height": 680
      },
      "maximumSize": {
        "width": 800,
        "height": 1400
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-23.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "https://openrouter.ai"
      ]
    }
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon-23.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest"]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-48.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest"]
    }
  ]
}
